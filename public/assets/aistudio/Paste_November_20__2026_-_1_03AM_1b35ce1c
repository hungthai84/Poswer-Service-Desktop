<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Windows 11 UI Concept</title>
  <!-- Office UI Fabric Icons for Windows 11 system icons -->
  <link rel="stylesheet" href="https://static2.sharepointonline.com/files/fabric/office-ui-fabric-core/11.0.0/css/fabric.min.css" />
  <!-- jQuery & jQuery UI for draggable panels and animations -->
  <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
  
  <style>
    @import url('https://fonts.cdnfonts.com/css/segoe-ui-4');

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      overflow: hidden;
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
      user-select: none;
    }

    .container {
      background-image: url('https://cdn.wallpaperhub.app/cloudcache/6/7/6/7/2/e/67672e59d11736a6035042a23791af5e5dcc9645.jpg');
      background-color: #0b4f8a;
      background-size: cover;
      background-position: center;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-image 0.4s ease;
    }

    /* Dark mode support */
    body.dark-mode .panel::after,
    body.dark-mode .taskbar::after {
      background-color: #202020;
      opacity: 0.78;
    }
    body.dark-mode .panel,
    body.dark-mode .noteBodyText,
    body.dark-mode .header,
    body.dark-mode .settingsItem,
    body.dark-mode .taskbar,
    body.dark-mode .startMenuContainer,
    body.dark-mode .startMenuIconText,
    body.dark-mode .startMenuRecommended-Text,
    body.dark-mode .profileName,
    body.dark-mode .settingsName {
      color: #f3f3f3;
    }
    body.dark-mode .lightText {
      color: #bbbbbb;
    }
    body.dark-mode .settingsSystemOption,
    body.dark-mode .panel-left-day,
    body.dark-mode .allAppsButton,
    body.dark-mode .moreButton {
      background-color: rgba(50, 50, 50, 0.55);
      color: #fff;
    }

    .panel {
      border-radius: 8px;
      width: 700px;
      max-width: 95vw;
      height: 500px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.25);
      position: fixed;
      border: 1px solid rgba(255, 255, 255, 0.35);
      overflow: hidden;
    }

    .panel::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: -1;
      opacity: 0.75;
      background-color: #f3f3f3;
      border-radius: 8px;
      background-image: url("https://s3-us-west-2.amazonaws.com/s.cdpn.io/59615/bg--acrylic-light.png");
      transition: background-color 0.3s ease;
    }

    .panel .panel-right {
      width: 240px;
      background: rgba(255, 255, 255, 0);
      opacity: 0.85;
      position: absolute;
      right: 0;
      top: 35px;
      height: 269px;
      border-bottom-right-radius: 8px;
      padding: 20px 30px;
      text-align: right;
    }

    .panel .panel-left {
      width: 100%;
      height: 100%;
      position: absolute;
      left: 0;
      top: 0;
      padding: 50px 40px 0 40px;
      pointer-events: none;
    }

    .panel-left-highlow-text {
      opacity: 0.85;
      font-size: 1.4rem;
      font-weight: 500;
    }

    .panel-left-locationdate-text {
      opacity: 0.8;
      font-size: 1rem;
      margin-top: 5px;
    }

    .panel-left-day {
      background-color: rgba(255, 255, 255, 0.45);
      margin-left: -10px;
      padding: 10px 14px;
      width: 165px;
      border-radius: 6px;
      margin-top: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
    }

    .startMenuPanel {
      bottom: 62px;
      height: 620px;
      width: 640px;
      max-width: 95vw;
    }

    .startMenuContainer {
      padding: 35px 50px 20px 50px;
      font-weight: 600;
      font-size: 0.95rem;
      position: relative;
    }

    .shutdownRow {
      position: absolute;
      bottom: 0;
      width: 100%;
      background-color: rgba(180, 180, 180, 0.25);
      border-top: 1px solid rgba(163, 163, 163, 0.45);
      height: 68px;
      display: flex;
      align-items: center;
    }

    .profilePicture {
      background-image: url('https://media-exp1.licdn.com/dms/image/C4E03AQFRViiHuMISHw/profile-displayphoto-shrink_100_100/0/1560275616234?e=1634169600&v=beta&t=WMfRRfR1ifCsWxHJtYN4Eow7j8B9fOLQ2rlBzIzbJsM');
      background-color: #226cb1;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-size: cover;
      position: absolute;
      left: 55px;
    }

    .settingsPanelBody {
      padding: 20px 30px;
      overflow: visible !important;
      position: relative;
    }

    .settingsPanel {
      height: 580px;
      width: 740px;
    }

    .settingsProfileRow {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .profilePicture-settings {
      background-image: url('https://media-exp1.licdn.com/dms/image/C4E03AQFRViiHuMISHw/profile-displayphoto-shrink_100_100/0/1560275616234?e=1634169600&v=beta&t=WMfRRfR1ifCsWxHJtYN4Eow7j8B9fOLQ2rlBzIzbJsM');
      background-color: #226cb1;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background-size: cover;
      display: inline-block;
    }

    .settingsName {
      display: inline-block;
      line-height: 1.2rem;
      opacity: 0.9;
      font-weight: 600;
    }

    .settingsLeftColumn {
      padding: 20px 0;
      width: 30%;
      display: inline-block;
      vertical-align: top;
    }

    .settingsItem {
      color: rgba(0, 0, 0, 0.85);
      padding: 7px 12px;
      border-radius: 4px;
      margin-bottom: 2px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: background 0.15s;
    }

    .settingsItem:hover {
      background: rgba(255, 255, 255, 0.35);
    }

    .settingsItem.active {
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.45) 0%, rgba(210, 210, 210, 0.25) 100%);
      border-left: 3px solid #226cb1;
      font-weight: 600;
    }

    .settingsRightColumn {
      width: 68%;
      display: inline-block;
      vertical-align: top;
      position: relative;
      padding-top: 20px;
    }

    .themePreview {
      background-image: url('https://www.bleepstatic.com/images/news/Microsoft/windows-11/leak/new-default-wallpaper.jpg');
      background-size: cover;
      width: 170px;
      height: 105px;
      border-radius: 6px;
      border: 2px solid rgba(255, 255, 255, 0.6);
      display: inline-block;
      margin-left: 20px;
      vertical-align: top;
      transition: background-image 0.3s ease;
    }

    .themeSelect {
      display: inline-block;
      margin-left: 20px;
      vertical-align: top;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .lightThemePick, .darkThemePick {
      margin-top: 12px;
      width: 96px;
      height: 60px;
      display: inline-block;
      background-size: cover;
      border-radius: 6px;
      border: 3px solid rgba(255, 255, 255, 0.45);
      background-repeat: no-repeat;
      cursor: pointer;
      margin-right: 8px;
      transition: transform 0.15s, border-color 0.15s;
    }

    .lightThemePick:hover, .darkThemePick:hover {
      transform: scale(1.03);
    }

    .lightThemePick {
      background-image: url('https://www.bleepstatic.com/images/news/Microsoft/windows-11/leak/new-default-wallpaper.jpg');
    }

    .darkThemePick {
      background-image: url('https://cdn.vox-cdn.com/uploads/chorus_asset/file/22661965/img19.jpg');
    }

    .lightThemePick.active, .darkThemePick.active {
      border: 3px solid #226cb1;
    }

    .systemIcon {
      font-size: 1.6rem;
      color: #226cb1;
      vertical-align: middle;
    }

    .settingsSystemOption {
      margin-top: 8px;
      background-color: rgba(255, 255, 255, 0.5);
      padding: 12px 16px;
      border-radius: 6px;
      opacity: 0.9;
      display: flex;
      align-items: center;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    .settingsSystemOption:hover {
      background-color: rgba(255, 255, 255, 0.75);
    }

    .settingsOptions {
      margin-left: 20px;
      margin-top: 20px;
    }

    .settingsSystemOptionText {
      display: inline-block;
      margin-left: 15px;
      font-size: 0.9rem;
      font-weight: 500;
    }

    .profileName {
      position: absolute;
      left: 105px;
      opacity: 0.9;
      font-size: 0.9rem;
      font-weight: 500;
    }

    .powerButton {
      font-size: 1.2rem;
      opacity: 0.75;
      position: absolute;
      right: 50px;
      cursor: pointer;
      padding: 8px;
      border-radius: 4px;
      transition: background 0.2s;
    }

    .powerButton:hover {
      background: rgba(255, 255, 255, 0.4);
      opacity: 1;
    }

    .iconRow {
      padding: 0 40px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .startMenuIcon {
      width: 16%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 8px 4px;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.15s;
    }

    .startMenuIcon:hover {
      background-color: rgba(255, 255, 255, 0.45);
    }

    .startMenuRecommended {
      width: 48%;
      display: flex;
      align-items: center;
      padding: 8px;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.15s;
    }

    .startMenuRecommended:hover {
      background-color: rgba(255, 255, 255, 0.45);
    }

    .startMenuRecommended-Icon {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .startMenuRecommended-Text {
      opacity: 0.9;
      font-size: 0.85rem;
      margin-left: 12px;
      line-height: 1.25;
    }

    .startMenuIcon-Inner {
      width: 36px;
      height: 36px;
    }

    .allAppsButton, .moreButton {
      background-color: rgba(255, 255, 255, 0.5);
      border-radius: 4px;
      padding: 4px 10px;
      text-align: center;
      position: absolute;
      right: 50px;
      top: 32px;
      cursor: pointer;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }

    .startMenuIconText {
      margin-top: 6px;
      text-align: center;
      font-size: 0.78rem;
      white-space: nowrap;
      opacity: 0.9;
    }

    .weatherPanel {
      height: 400px;
      width: 460px;
    }

    .cloud {
      background-image: url("https://i.pinimg.com/originals/60/a8/2c/60a82c6cf7fda046b291e6b2c78ea531.png");
      width: 380px;
      height: 380px;
      position: absolute;
      background-size: contain;
      background-repeat: no-repeat;
      left: 185px;
      top: 230px;
      pointer-events: none;
      -webkit-filter: drop-shadow(8px 8px 20px rgba(0, 0, 0, 0.3));
      filter: drop-shadow(8px 8px 20px rgba(0, 0, 0, 0.3));
    }

    .weatherTemperature {
      font-size: 4.5rem;
      opacity: 0.85;
      line-height: 4.5rem;
      font-weight: 300;
    }

    .weatherTemperature small {
      font-size: 1.5rem;
      display: block;
      margin-top: 8px;
    }

    .note-panel {
      max-height: 500px;
    }

    .taskbar {
      position: fixed;
      bottom: 0;
      width: 100vw;
      height: 48px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 4px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4px;
      z-index: 1000;
      border-top: 1px solid rgba(255, 255, 255, 0.3);
    }

    .taskbar::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: -1;
      opacity: 0.72;
      background-color: #f3f3f3;
      background-image: url("https://s3-us-west-2.amazonaws.com/s.cdpn.io/59615/bg--acrylic-light.png");
    }

    .taskbarTemp {
      font-size: 0.75rem;
      font-weight: 600;
      margin-left: -4px;
      margin-right: 8px;
      opacity: 0.85;
    }

    .taskbarIcon {
      font-size: 1.5rem;
      display: inline-block;
    }

    .taskbarTime {
      display: inline-block;
      position: absolute;
      right: 18px;
      font-size: 0.75rem;
      text-align: right;
      line-height: 1.15;
    }

    .taskbarIconWrapper {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      width: 40px;
      height: 40px;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.2s linear, transform 0.1s ease;
    }

    .taskbarIconWrapper:active {
      transform: scale(0.92);
    }

    .taskbarIconWrapper.active {
      background-color: rgba(255, 255, 255, 0.25);
    }

    .taskbarIconWrapper.focused,
    .taskbarIconWrapper:hover {
      background-color: rgba(255, 255, 255, 0.55);
    }

    .taskbarIconIndicator {
      position: absolute;
      left: 12px;
      width: 16px;
      height: 3px;
      bottom: 2px;
      background-color: #226cb1;
      border-radius: 2px;
      transform-origin: center;
      transition: transform 0.2s linear;
    }

    .taskbarIconIndicator.unfocused {
      transform: scaleX(0.4);
      background-color: #777;
    }

    .taskbarNoteIcon {
      color: #123fbc;
    }

    .noteBodyText {
      padding: 25px 50px;
      color: #222222;
      line-height: 1.6;
      font-size: 0.95rem;
    }

    .noteBodyText ul {
      padding-left: 20px;
    }

    .noteBodyText li {
      margin-bottom: 8px;
    }

    .panel-body {
      max-height: 465px;
      overflow-y: auto;
    }

    .panel-body::-webkit-scrollbar-track {
      background-color: rgba(0, 0, 0, 0);
    }

    .panel-body::-webkit-scrollbar {
      width: 6px;
      background-color: rgba(0, 0, 0, 0);
    }

    .panel-body::-webkit-scrollbar-thumb {
      background-color: rgba(0, 0, 0, 0.25);
      border-radius: 3px;
    }

    .lightText {
      color: #555555;
      font-size: 0.8rem;
    }

    .header {
      color: #444;
      height: 35px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: move;
    }

    .header > .headerIcons {
      position: absolute;
      right: 0;
      top: 0;
      display: inline-flex;
      font-size: 0.75rem;
    }

    .header > .headerIcons > i {
      cursor: pointer;
      transition: all 0.15s linear;
      padding: 11px 15px;
    }

    .header > .headerIcons > i:hover {
      color: #000;
      background-color: rgba(255, 255, 255, 0.55);
    }

    .header > .headerIcons > i.ms-Icon--ChromeClose:hover {
      background-color: #e81123;
      color: #fff;
    }

    .headerTitleIcon {
      font-size: 0.95rem;
      margin-left: 14px;
      color: #123fbc;
    }

    .headerTitleText {
      display: inline-block;
      margin-left: 8px;
      font-size: 0.85rem;
      font-weight: 500;
    }

    .headerImage {
      background-image: url('https://www.bleepstatic.com/images/news/Microsoft/windows-11/leak/new-default-wallpaper.jpg');
      background-color: #106ebe;
      width: 100%;
      height: 240px;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      color: #fff;
    }

    .headerImageOverlay {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.3rem;
      font-weight: 400;
      text-shadow: 0px 2px 12px rgba(0, 0, 0, 0.45);
      background-color: rgba(4, 27, 104, 0.15);
      width: 100%;
      height: 100%;
    }

    .mt30 { margin-top: 30px; }
    .mt20 { margin-top: 20px; }

    .zindex0 { z-index: 10; }
    .zindex1 { z-index: 20; }
    .zindex2 { z-index: 30; }
    .zindex3 { z-index: 40; }

    /* Shutdown overlay */
    #shutdownScreen {
      position: fixed;
      inset: 0;
      background: #000;
      color: #fff;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      font-size: 1.4rem;
      gap: 20px;
    }
    .restartBtn {
      padding: 10px 24px;
      background: #0078d4;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 0.95rem;
      cursor: pointer;
    }
    .restartBtn:hover {
      background: #106ebe;
    }
  </style>
</head>
<body>

<div id="shutdownScreen">
  <div>Shutting down Windows 11...</div>
  <button class="restartBtn" onclick="RestartOS()">Turn Power On</button>
</div>

<div class="container">
  <!-- WEATHER PANEL -->
  <div class="panel weatherPanel" onmousedown="FocusWindow('weather')" style="display:none;" id="weatherPanel">
    <div class="header noselect">
      <span class="lightText"><i class="ms-Icon ms-Icon--CloudWeather headerTitleIcon" aria-hidden="true"></i><span class="headerTitleText"> Weather</span></span>
      <div class="headerIcons">
        <i class="ms-Icon ms-Icon--ChromeMinimize" aria-hidden="true" onClick="MinimizeWindow('weather')"></i>
        <i class="ms-Icon ms-Icon--ChromeClose" aria-hidden="true" onClick="CloseWindow('weather')"></i>
      </div>
    </div>
    <div class="panel-inner">
      <div class="panel-left">
        <div class="panel-left-highlow-text">
          High 74° F <br />
          Low 57° F<br />
        </div>
        <div class="panel-left-locationdate-text">
          Ann Arbor, Michigan<br /><br />
        </div>
        <div class="panel-left-day">
          <span>Tomorrow 74°</span> <i class="ms-Icon ms-Icon--Sunny" style="color:#f59e0b;" aria-hidden="true"></i>
        </div>
        <div class="panel-left-day">
          <span>Wednesday 72°</span> <i class="ms-Icon ms-Icon--Rain" style="color:#0284c7;" aria-hidden="true"></i>
        </div>
        <div class="panel-left-day">
          <span>Thursday 72°</span> <i class="ms-Icon ms-Icon--Fog" style="color:#64748b;" aria-hidden="true"></i>
        </div>
      </div>
    </div>
    <div class="panel-right">
      <div class="weatherTemperature">65° F<small>Cloudy</small></div>
    </div>
    <div class="cloud"></div>
  </div>

  <!-- START MENU PANEL -->
  <div class="panel startMenuPanel noselect" style="display:none" id="startMenuPanel">
    <div class="startMenuContainer">
      Pinned
      <div class="allAppsButton">
        <small style="opacity: .85">All apps &gt;</small>
      </div>
    </div>
    <div class="iconRow">
      <div class="startMenuIcon">
        <svg class="startMenuIcon-Inner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
          <defs>
