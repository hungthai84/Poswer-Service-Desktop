          <div class="settingsSystemOption">
            <i class="ms-Icon ms-Icon--Brush systemIcon" aria-hidden="true"></i>
            <div class="settingsSystemOptionText">
              Themes <br />
              <small class="lightText">Install, create, manage</small>
