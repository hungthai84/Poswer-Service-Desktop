      </div>
    </div>
  </div>
</div>

<!-- TASKBAR -->
<div class="taskbar noselect">
  <div class="taskbarIconWrapper" id="startmenuTaskbarIcon" onClick="TaskbarIconClick('startMenu')">
    <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 443.704 443.704">
      <path style="fill:#0078d4;" d="M 227.570313 307.621094 L 227.570313 387.675781 L 387.675781 387.675781 L 387.675781 227.570313 L 227.570313 227.570313 Z M 56.03125 307.621094 L 56.03125 387.675781 L 216.132813 387.675781 L 216.132813 227.570313 L 56.03125 227.570313 Z M 227.570313 136.082031 L 227.570313 216.132813 L 387.675781 216.132813 L 387.675781 56.03125 L 227.570313 56.03125 Z M 56.03125 136.082031 L 56.03125 216.132813 L 216.132813 216.132813 L 216.132813 56.03125 L 56.03125 56.03125 Z" />
    </svg>
  </div>
  <div class="taskbarIconWrapper" id="settingsTaskbarIcon" onClick="TaskbarIconClick('settings')">
    <i class="ms-Icon ms-Icon--Settings taskbarIcon taskbarItem" aria-hidden="true"></i>
    <div class="taskbarIconIndicator" style="display:none;" id="settingsTaskbarIndicator"></div>
  </div>
  <div class="taskbarIconWrapper">
    <img src="https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/word_48x1.svg" width="26" height="26" alt="Word" />
  </div>
  <div class="taskbarIconWrapper">
    <img src="https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/powerpoint_48x1.svg" width="26" height="26" alt="PowerPoint" />
  </div>
  <div class="taskbarIconWrapper">
    <img src="https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/excel_48x1.svg" width="26" height="26" alt="Excel" />
  </div>
  <div class="taskbarIconWrapper">
    <img src="https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/office_48x1.svg" width="26" height="26" alt="Office" />
  </div>
  <div class="taskbarIconWrapper">
    <img src="https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/outlook_48x1.svg" width="26" height="26" alt="Outlook" />
  </div>
  <div class="taskbarIconWrapper">
    <img src="https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/teams_48x1.svg" width="26" height="26" alt="Teams" />
  </div>
  <div class="taskbarIconWrapper active focused" id="noteTaskbarIcon" onClick="TaskbarIconClick('welcome')">
    <i class="ms-Icon ms-Icon--QuickNoteSolid taskbarIcon taskbarItem taskbarNoteIcon" aria-hidden="true"></i>
    <div class="taskbarIconIndicator" id="noteTaskbarIndicator"></div>
  </div>
  <div class="taskbarIconWrapper" id="weatherTaskbarIcon" onClick="TaskbarIconClick('weather')">
    <i class="ms-Icon ms-Icon--CloudWeather taskbarIcon taskbarItem" aria-hidden="true"></i>
    <div class="taskbarIconIndicator" style="display:none;" id="weatherTaskbarIndicator"></div>
  </div>
  <div class="taskbarTemp">65°</div>
  <div class="taskbarTime"></div>
</div>

<script>
  var windows = [
    {
      name: "welcome",
      isOpen: true,
      isMinimized: false,
      hasFocus: true,
      taskbarid: "#noteTaskbarIcon",
      taskbarindicator: "#noteTaskbarIndicator",
      windowid: "#welcomenote"
    },
    {
      name: "settings",
      isOpen: false,
      isMinimized: false,
      hasFocus: false,
      taskbarid: "#settingsTaskbarIcon",
      taskbarindicator: "#settingsTaskbarIndicator",
      windowid: "#settingswindow"
    },
    {
      name: "weather",
      isOpen: false,
      isMinimized: false,
      hasFocus: false,
      taskbarid: "#weatherTaskbarIcon",
      taskbarindicator: "#weatherTaskbarIndicator",
      windowid: "#weatherPanel"
    },
    {
      name: "startMenu",
      isOpen: false,
      isMinimized: false,
      hasFocus: false,
      taskbarid: "#startmenuTaskbarIcon",
      taskbarindicator: "",
      windowid: "#startMenuPanel"
    }
  ];

  var openedWindows = [windows[0]];

  // Make panels draggable by their headers
  $(".panel").draggable({
    appendTo: "body",
    handle: ".header",
    containment: "window"
  });

  function FocusWindow(windowToFocus) {
    var object = windows.find(obj => obj.name === windowToFocus);
    if (!object) return;

    object.isOpen = true;
    object.isMinimized = false;
    object.hasFocus = true;

    openedWindows = openedWindows.filter(obj => obj.name !== object.name);
    openedWindows.push(object);

    UpdateTaskBar();
    UpdateZIndex();
  }

  function CloseWindow(windowToClose) {
    var object = windows.find(obj => obj.name === windowToClose);
    if (!object) return;

    $(object.windowid).fadeOut(180);
    object.isOpen = false;
    object.isMinimized = false;
    object.hasFocus = false;

    openedWindows = openedWindows.filter(obj => obj.name !== object.name);
    UpdateTaskBar();
    UpdateZIndex();
  }

  function MinimizeWindow(windowToClose) {
    var object = windows.find(obj => obj.name === windowToClose);
    if (!object) return;

    $(object.windowid).effect("drop", { direction: "down" }, 200);
    object.isOpen = true;
    object.isMinimized = true;
    object.hasFocus = false;

    openedWindows = openedWindows.filter(obj => obj.name !== object.name);
    UpdateTaskBar();
    UpdateZIndex();
  }

  function TaskbarIconClick(clickedIcon) {
    var object = windows.find(obj => obj.name === clickedIcon);
    if (!object) return;

    if (object.name === "startMenu") {
      if (object.isOpen) {
        $(object.windowid).toggle("drop", { direction: "down" }, 180);
        object.isOpen = false;
        object.isMinimized = false;
        object.hasFocus = false;
        openedWindows = openedWindows.filter(obj => obj.name !== "startMenu");
      } else {
        $(object.windowid).toggle("drop", { direction: "down" }, 180);
        object.isOpen = true;
        object.isMinimized = false;
        object.hasFocus = true;
        openedWindows.push(object);
      }
    } else {
      // Close Start menu if open
      if (windows[3].isOpen) {
        $(windows[3].windowid).toggle("drop", { direction: "down" }, 180);
        windows[3].isOpen = false;
        windows[3].isMinimized = false;
        windows[3].hasFocus = false;
        openedWindows = openedWindows.filter(obj => obj.name !== "startMenu");
      }

      if (object.isOpen) {
        if (object.isMinimized) {
          $(object.windowid).toggle("drop", { direction: "down" }, 200);
          object.isOpen = true;
          object.isMinimized = false;
          object.hasFocus = true;
          openedWindows.push(object);
        } else {
          if (object.hasFocus) {
            $(object.windowid).effect("drop", { direction: "down" }, 200);
            object.isOpen = true;
            object.isMinimized = true;
            object.hasFocus = false;
            openedWindows = openedWindows.filter(obj => obj.name !== object.name);
          } else {
            object.isOpen = true;
            object.isMinimized = false;
            object.hasFocus = true;
            openedWindows = openedWindows.filter(obj => obj.name !== object.name);
            openedWindows.push(object);
          }
        }
      } else {
        $(object.windowid).fadeIn(180);
        object.isOpen = true;
        object.isMinimized = false;
        object.hasFocus = true;
        openedWindows.push(object);
      }
    }
    UpdateTaskBar();
    UpdateZIndex();
  }

  function UpdateTaskBar() {
    for (var i = 0; i < windows.length; i++) {
      windows[i].hasFocus = false;
    }

    if (openedWindows.length > 0) {
      openedWindows[openedWindows.length - 1].hasFocus = true;
    }

    for (var i = 0; i < windows.length; i++) {
      $(windows[i].taskbarid).removeClass("active focused");

      if (windows[i].isOpen) {
        $(windows[i].taskbarid).addClass("active");
        $(windows[i].taskbarindicator).removeClass("unfocused");

        if (windows[i].hasFocus) {
          $(windows[i].taskbarindicator).show();
          $(windows[i].taskbarid).addClass("focused");
        }
        if (windows[i].isMinimized) {
          $(windows[i].taskbarindicator).show();
          $(windows[i].taskbarindicator).addClass("unfocused");
        }
      } else {
        $(windows[i].taskbarindicator).addClass("unfocused").hide();
      }
    }
  }

  function UpdateZIndex() {
    for (var i = 0; i < openedWindows.length; i++) {
      for (var j = 0; j < 5; j++) {
        $(openedWindows[i].windowid).removeClass("zindex" + j);
      }
      $(openedWindows[i].windowid).addClass("zindex" + i);
    }
  }

  // Theme Switcher inside Settings
  function SetTheme(mode) {
    if (mode === 'dark') {
      document.body.classList.add('dark-mode');
      $('#darkPick').addClass('active');
      $('#lightPick').removeClass('active');
      $('.container').css('background-image', "url('https://cdn.vox-cdn.com/uploads/chorus_asset/file/22661965/img19.jpg')");
      $('#themePreviewBox').css('background-image', "url('https://cdn.vox-cdn.com/uploads/chorus_asset/file/22661965/img19.jpg')");
    } else {
      document.body.classList.remove('dark-mode');
      $('#lightPick').addClass('active');
      $('#darkPick').removeClass('active');
      $('.container').css('background-image', "url('https://cdn.wallpaperhub.app/cloudcache/6/7/6/7/2/e/67672e59d11736a6035042a23791af5e5dcc9645.jpg')");
      $('#themePreviewBox').css('background-image', "url('https://www.bleepstatic.com/images/news/Microsoft/windows-11/leak/new-default-wallpaper.jpg')");
    }
  }

  // Power Button Shutdown / Restart
  function ShutdownOS() {
    $('#shutdownScreen').css('display', 'flex').hide().fadeIn(400);
  }
  function RestartOS() {
    $('#shutdownScreen').fadeOut(400);
  }

  // Taskbar Clock
  function GetTime() {
    var date = new Date();
    var today = formatAMPM(date);
    var month = date.getMonth() + 1;
    var calDate = month + "/" + date.getDate() + "/" + date.getFullYear();
    $(".taskbarTime").html(today + "<br />" + calDate);
  }

  function formatAMPM(date) {
    var hours = date.getHours();
    var minutes = date.getMinutes();
    var ampm = hours >= 12 ? "PM" : "AM";
    hours = hours % 12;
    hours = hours ? hours : 12;
    minutes = minutes < 10 ? "0" + minutes : minutes;
    return hours + ":" + minutes + " " + ampm;
  }

  GetTime();
  setInterval(GetTime, 15000);
</script>

